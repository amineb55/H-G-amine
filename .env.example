# Application
APP_NAME="HSE Inspection Analysis Service"
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=127.0.0.1
PORT=8000

# Storage and upload limits
# Inspection store: "firestore" (default) or "memory" for local work
STORE_BACKEND=firestore
STORE_COLLECTION=inspections
# Empty falls back to the project the ambient credentials name.
GOOGLE_CLOUD_PROJECT=

UPLOAD_DIR=data/uploads
# Evidence storage: "gcs" (default) or "local" for development
STORAGE_BACKEND=local
EVIDENCE_BUCKET=hse-audit-agent-evidence
# Used by the local backend only
EVIDENCE_DIR=data/evidence
EVIDENCE_MAX_PIXELS=1280
MAX_UPLOAD_BYTES=209715200
MAX_IMAGES=10

# Analysis engine (provider credentials, injected behind the engine interface)
ANALYSIS_ENGINE_API_KEY=
# Leave empty to use the provider's default model.
ANALYSIS_ENGINE_MODEL=
ANALYSIS_ENGINE_TIMEOUT_SECONDS=120
# Frames sampled per second of video. Lower means cheaper.
ANALYSIS_ENGINE_VIDEO_FPS=1.0

# Email notifications (secret names on Cloud Run: notifier-api-key,
# notifier-sender-email). BREVO_* are still read as a fallback.
NOTIFIER_API_KEY=
NOTIFIER_SENDER_EMAIL=
NOTIFIER_SENDER_NAME=Inspection HSE
NOTIFIER_TIMEOUT_SECONDS=30
# Leave empty to use the notifier's own endpoint.
NOTIFIER_API_URL=
