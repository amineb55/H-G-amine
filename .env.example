# Application
APP_NAME="HSE Inspection Analysis Service"
ENVIRONMENT=development
DEBUG=false

# Server
HOST=127.0.0.1
PORT=8000

# Storage and upload limits
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=209715200
MAX_IMAGES=10

# Analysis engine (provider credentials, injected behind the engine interface)
ANALYSIS_ENGINE_API_KEY=
ANALYSIS_ENGINE_MODEL=
